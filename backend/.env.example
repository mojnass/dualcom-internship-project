# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (local or MongoDB Atlas)
Mongo_URI=mongodb://localhost:27017/internship-project

# Frontend address allowed by CORS (Vite's default dev port)
CLIENT_URL=http://localhost:5173

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Backblaze B2 (S3-compatible API) for product and store images
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
